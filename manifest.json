{
  "manifest_version": 3,
  "name": "TimeSpoofer",
  "version": "3.0",
  "author": "Igor Bogdanov",
  "homepage_url": "https://github.com/IMontecarlo/TimeSpoofer",
  "description": "Override timezone, locale, and reported device memory in Chromium tabs.",
  "permissions": ["storage", "tabs", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TimeSpoofer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/timezonesecure-gray-16.png",
      "32": "icons/timezonesecure-gray-32.png",
      "48": "icons/timezonesecure-gray-48.png",
      "128": "icons/timezonesecure-gray-128.png"
    }
  },
  "icons": {
    "16": "icons/timezonesecure-16.png",
    "32": "icons/timezonesecure-32.png",
    "48": "icons/timezonesecure-48.png",
    "128": "icons/timezonesecure-128.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["early.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true
  }]
}
